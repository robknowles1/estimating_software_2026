<% short_codes = estimate.estimate_materials.filter_map { |em| em.short_code.presence&.downcase } %>
<% needs_review = short_codes.any? && short_codes.none? { |code| line_item.description.to_s.downcase.include?(code) } %>
<div id="<%= dom_id(line_item) %>" class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-3">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-sm font-semibold text-slate-900"><%= line_item.description %></span>
        <span class="text-xs text-slate-400 font-mono"><%= line_item.quantity %> <%= line_item.unit %></span>
        <% if needs_review %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
            <%= t("line_items.card.needs_review") %>
          </span>
        <% end %>
      </div>
      <% if line_item.product.present? %>
        <p class="text-xs text-slate-400 italic"><%= t("line_items.line_item.based_on", product: line_item.product.name) %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <% if local_assigns[:totals] %>
        <% result = totals.line_item_results[line_item.id] %>
        <% if result %>
          <span class="text-sm font-semibold text-slate-700"><%= number_to_currency(result[:non_burdened_total]) %></span>
        <% end %>
      <% end %>
      <%= link_to t("common.edit"), edit_estimate_line_item_path(estimate, line_item),
          class: "text-xs text-slate-500 hover:text-amber-700 font-medium transition-colors" %>
      <%= button_to t("common.delete"), estimate_line_item_path(estimate, line_item), method: :delete,
          form: { data: { turbo_confirm: t("line_items.line_item.confirm_delete") } },
          class: "text-xs text-red-400 hover:text-red-600 font-medium transition-colors bg-transparent border-0 p-0 cursor-pointer" %>
    </div>
  </div>
</div>
