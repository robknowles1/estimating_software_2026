<%# Client header %>
<div class="flex items-start justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-slate-900"><%= @client.company_name %></h1>
    <% if @client.address.present? %>
      <p class="text-slate-500 text-sm mt-0.5"><%= @client.address %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to t("common.edit"), edit_client_path(@client),
        class: "inline-flex items-center gap-1.5 text-slate-600 hover:text-amber-700 text-sm font-medium border border-slate-300 rounded-lg px-3 py-2 transition-colors" %>
    <%= button_to t("common.delete"), client_path(@client), method: :delete,
        class: "inline-flex items-center gap-1.5 text-red-600 hover:text-red-700 text-sm font-medium border border-red-200 hover:border-red-300 rounded-lg px-3 py-2 transition-colors bg-white",
        data: { turbo_confirm: t(".confirm_delete", name: @client.company_name) } %>
  </div>
</div>

<%# General Notes (free-text field from the client edit form) %>
<% if @client.notes.present? %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">
    <h2 class="text-sm font-semibold text-slate-700 mb-2"><%= t(".general_notes_label") %></h2>
    <p class="text-sm text-slate-600 whitespace-pre-line"><%= @client.notes %></p>
  </div>
<% end %>

<%# Contacts section %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
    <h2 class="text-base font-semibold text-slate-900"><%= t(".contacts_heading") %></h2>
    <%= link_to new_client_contact_path(@client),
        class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white px-3 py-1.5 rounded-lg text-sm font-semibold transition-colors" do %>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      <%= t(".add_contact") %>
    <% end %>
  </div>

  <% if @contacts.any? %>
    <table class="min-w-full">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t(".name_header") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= Contact.human_attribute_name(:title) %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t(".role_header") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= Contact.human_attribute_name(:email) %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= Contact.human_attribute_name(:phone) %></th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @contacts.each do |contact| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-slate-900"><%= "#{contact.first_name} #{contact.last_name}" %></span>
                <% if contact.is_primary? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800"><%= t(".primary_badge") %></span>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-500"><%= contact.title.presence || t("common.not_provided") %></td>
            <td class="px-6 py-4 text-sm text-slate-500"><%= contact.role.presence || t("common.not_provided") %></td>
            <td class="px-6 py-4 text-sm text-slate-500"><%= contact.email.presence || t("common.not_provided") %></td>
            <td class="px-6 py-4 text-sm text-slate-500"><%= contact.phone.presence || t("common.not_provided") %></td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-3">
                <%= link_to t("common.edit"), edit_client_contact_path(@client, contact),
                    class: "text-slate-600 hover:text-amber-700 text-sm font-medium transition-colors" %>
                <%= button_to t("common.delete"), client_contact_path(@client, contact), method: :delete,
                    class: "text-red-500 hover:text-red-700 text-sm font-medium transition-colors bg-transparent border-0 p-0 cursor-pointer",
                    data: { turbo_confirm: t("contacts.confirm_delete") } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <p class="text-slate-500 text-sm"><%= t(".no_contacts") %></p>
      <%= link_to t(".add_contact"), new_client_contact_path(@client),
          class: "mt-3 text-sm text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
    </div>
  <% end %>
</div>

<%# Activity / Notes timeline (append-only ClientNote log) %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mt-6">
  <div class="px-6 py-4 border-b border-slate-200">
    <h2 class="text-base font-semibold text-slate-900"><%= t(".notes_timeline_heading") %></h2>
  </div>

  <div class="px-6 py-5">
    <%= form_with model: [ @client, (@client_note || ClientNote.new(client: @client)) ], url: client_client_notes_path(@client), method: :post do |f| %>
      <% note = f.object %>
      <% if note.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-3 text-sm" role="alert">
          <ul class="list-disc list-inside space-y-0.5 text-red-600">
            <% note.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= f.text_area :body, rows: 3, placeholder: t(".add_note_placeholder"),
          class: "w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
      <div class="mt-3">
        <%= f.submit t(".add_note_button"),
            class: "bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @client_notes.any? %>
    <ul class="divide-y divide-slate-100 border-t border-slate-200">
      <% @client_notes.each do |client_note| %>
        <li class="px-6 py-4 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm text-slate-700 whitespace-pre-line"><%= client_note.body %></p>
            <p class="text-xs text-slate-400 mt-1"><%= client_note.created_at.strftime("%b %-d, %Y %-l:%M %p") %></p>
          </div>
          <%= button_to t("common.delete"), client_client_note_path(@client, client_note), method: :delete,
              class: "text-red-500 hover:text-red-700 text-sm font-medium transition-colors bg-transparent border-0 p-0 cursor-pointer shrink-0",
              data: { turbo_confirm: t(".confirm_delete_note") } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="px-6 py-8 text-center border-t border-slate-200">
      <p class="text-slate-500 text-sm"><%= t(".no_notes") %></p>
    </div>
  <% end %>
</div>

<%# Estimates panel (read-only list of estimates bid to this client) %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mt-6">
  <div class="px-6 py-4 border-b border-slate-200">
    <h2 class="text-base font-semibold text-slate-900"><%= t(".estimates_heading") %></h2>
  </div>

  <% if @estimates.any? %>
    <table class="min-w-full">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t("estimates.index.col_number") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t("estimates.index.col_title") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t("estimates.index.col_status") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= Estimate.human_attribute_name(:job_start_date) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @estimates.each do |estimate| %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 font-mono text-xs">
              <%= link_to estimate.estimate_number, edit_estimate_path(estimate),
                  class: "text-amber-700 hover:text-amber-800 font-medium" %>
            </td>
            <td class="px-6 py-4 text-sm">
              <%= link_to estimate.title, edit_estimate_path(estimate),
                  class: "text-slate-900 hover:text-amber-700 font-medium" %>
            </td>
            <td class="px-6 py-4"><%= render "estimates/status_badge", status: estimate.status %></td>
            <td class="px-6 py-4 text-sm text-slate-500"><%= estimate.job_start_date&.strftime("%b %-d, %Y") || t("common.not_provided") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <p class="text-slate-500 text-sm"><%= t(".no_estimates") %></p>
    </div>
  <% end %>
</div>
