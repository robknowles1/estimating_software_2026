<% content_for :title, t("proposals.steps.inclusions.title") %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to t("proposals.back_to_estimate"), edit_estimate_path(@estimate),
        class: "text-sm text-slate-500 hover:text-slate-700 font-medium" %>
    <h1 class="text-xl font-semibold text-slate-900 mt-2"><%= t(".title") %></h1>
  </div>

  <%= render "proposals/step_indicator" %>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
    <%= render "proposals/steps/inclusions", proposal: @proposal, estimate: @estimate %>
  </div>
</div>
