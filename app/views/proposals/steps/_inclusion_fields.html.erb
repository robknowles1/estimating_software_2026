<div class="border border-slate-200 rounded-lg p-4" data-nested-list-target="row"
     data-controller="photo-preview">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex-1">
      <%= f.label :room_name, t("proposals.steps.inclusions.room_name_label"),
          class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.text_field :room_name,
          class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>
    <%= f.hidden_field :_destroy, data: { nested_list_target: "destroyFlag" } %>
    <button type="button" data-action="nested-list#remove"
        class="text-slate-400 hover:text-red-600 text-sm font-medium pt-6">
      <%= t("proposals.steps.inclusions.remove") %>
    </button>
  </div>

  <div class="mb-3">
    <%= f.label :bullet_points, t("proposals.steps.inclusions.bullet_points_label"),
        class: "block text-xs font-medium text-slate-600 mb-1" %>
    <%= f.text_area :bullet_points, rows: 3,
        placeholder: t("proposals.steps.inclusions.bullet_points_hint"),
        class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
  </div>

  <div>
    <%= f.label :photos, t("proposals.steps.inclusions.photos_label"),
        class: "block text-xs font-medium text-slate-600 mb-1" %>
    <% if f.object.respond_to?(:photos) && f.object.photos.attached? %>
      <div class="flex flex-wrap gap-2 mb-2">
        <% f.object.photos.each do |photo| %>
          <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded"><%= photo.filename %></span>
        <% end %>
      </div>
    <% end %>
    <%= f.file_field :photos, multiple: true, accept: "image/jpeg,image/png",
        data: { photo_preview_target: "input", action: "change->photo-preview#preview" },
        class: "block w-full text-xs text-slate-700 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 cursor-pointer" %>
    <p class="text-xs text-slate-400 mt-1"><%= t("proposals.steps.inclusions.photos_hint") %></p>
    <div data-photo-preview-target="previews" class="flex flex-wrap gap-2 mt-2"></div>
  </div>
</div>
