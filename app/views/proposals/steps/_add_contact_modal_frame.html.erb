<%# Inner Turbo Frame of the add-contact modal: the panel + quick-add form
    (first/last/email/phone). Extracted so the contacts#create failure stream can
    replace JUST this frame (keeping the dialog open) to show field errors.
    Locals: client, estimate_id, contact. estimate_id is passed through as a raw
    value (not an Estimate object) so a forged/mismatched id round-trips back into
    the hidden field unchanged instead of being reconstructed as a dummy record. %>
<%= turbo_frame_tag "add_contact_modal_frame", class: "w-full max-w-lg" do %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-xl">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
      <h2 id="add_contact_modal_title" class="text-lg font-semibold text-slate-900">
        <%= t("proposals.steps.opening.add_contact_modal.title") %>
      </h2>
      <button type="button"
              data-action="modal#close"
              aria-label="<%= t("proposals.steps.opening.add_contact_modal.close") %>"
              class="text-slate-400 hover:text-slate-600 text-2xl leading-none cursor-pointer">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <%= form_with model: contact, url: client_contacts_path(client),
        html: { class: "px-6 py-5" } do |f| %>
      <%= hidden_field_tag :estimate_id, estimate_id %>

      <% if contact.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-5 text-sm" role="alert">
          <p class="font-semibold mb-1">
            <%= t("contacts.form.errors", count: contact.errors.count) %>
          </p>
          <ul class="list-disc list-inside space-y-0.5 text-red-600">
            <% contact.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, t("proposals.steps.opening.add_contact_modal.first_name_label"),
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.text_field :first_name, required: true,
              class: "w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
        </div>
        <div>
          <%= f.label :last_name, t("proposals.steps.opening.add_contact_modal.last_name_label"),
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.text_field :last_name, required: true,
              class: "w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-4">
        <div>
          <%= f.label :email, t("proposals.steps.opening.add_contact_modal.email_label"),
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.email_field :email,
              class: "w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
        </div>
        <div>
          <%= f.label :phone, t("proposals.steps.opening.add_contact_modal.phone_label"),
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.telephone_field :phone,
              class: "w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
        </div>
      </div>

      <div class="flex items-center gap-3 mt-6 pt-5 border-t border-slate-200">
        <%= f.submit t("proposals.steps.opening.add_contact_modal.save"),
            class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
        <button type="button"
                data-action="modal#close"
                class="text-sm text-slate-500 hover:text-slate-700 font-medium transition-colors cursor-pointer">
          <%= t("proposals.steps.opening.add_contact_modal.cancel") %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
