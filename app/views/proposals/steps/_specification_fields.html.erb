<div class="grid grid-cols-12 gap-3 items-start" data-nested-list-target="row">
  <div class="col-span-4">
    <%= f.text_field :spec_number, placeholder: t("proposals.steps.specifications.number_placeholder"),
        class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
  </div>
  <div class="col-span-7">
    <%= f.text_field :spec_title, placeholder: t("proposals.steps.specifications.title_placeholder"),
        class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
  </div>
  <div class="col-span-1 flex items-center pt-1">
    <%= f.hidden_field :_destroy, data: { nested_list_target: "destroyFlag" } %>
    <button type="button" data-action="nested-list#remove"
        class="text-slate-400 hover:text-red-600 text-sm" aria-label="<%= t("proposals.steps.specifications.remove") %>">&times;</button>
  </div>
</div>
